# Copia este archivo como .env.local y rellena los valores.
# Ambos valores son PÚBLICOS por diseño (van al navegador); la seguridad la aplica RLS en Supabase.
# NUNCA pongas aquí la clave service_role ni la contraseña de la base de datos.

# Supabase > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase > Project Settings > API Keys > "anon public" (o la "publishable key" sb_publishable_...)
VITE_SUPABASE_ANON_KEY=
